# Contact form. Without these three the form degrades gracefully: it tells the
# visitor to email directly instead of pretending to have sent something.
#
# 1. Create a free account at https://resend.com and generate an API key.
# 2. Verify a sending domain (or use Resend's onboarding sender while testing).
# 3. Set all three in Vercel → Project → Settings → Environment Variables.

RESEND_API_KEY=

# Where messages land.
CONTACT_TO_EMAIL=piyushchugeja@gmail.com

# Must be on a domain verified in Resend. Not the visitor's address — their
# address goes in Reply-To, so replying from the inbox reaches them.
CONTACT_FROM_EMAIL=hello@piyushchugeja.com
